{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nodara image generation pricing",
  "type": "object",
  "required": [
    "schema_version",
    "currency",
    "billing_unit",
    "discount_percent",
    "models",
    "comparison_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "currency": {
      "const": "USD"
    },
    "billing_unit": {
      "const": "completed_image"
    },
    "discount_percent": {
      "const": 5
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profile_ids",
          "width",
          "height",
          "steps",
          "common_market_price",
          "nodara_price",
          "status",
          "quality_comparison"
        ],
        "properties": {
          "quality_comparison": {
            "type": "object",
            "required": [
              "status",
              "direct_comparison_allowed"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_evaluated",
                  "not_equivalent",
                  "verified_equivalent"
                ]
              },
              "direct_comparison_allowed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
